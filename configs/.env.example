# ============================================================
#  TG-Agent 配置文件（这是唯一需要你手动填写的配置文件）
# ============================================================
#
#  ▎快速上手（三步）
#   1. BOT_TOKEN   —— 创建 Telegram 机器人后，@BotFather 给你的令牌
#   2. ADMIN_IDS   —— 你的 Telegram 数字 ID（找 @userinfobot 发送任意消息即可看到）
#   3. LLM_API_KEY —— DeepSeek / OpenAI 等大模型的 API 密钥（下面对应章节有说明）
#
#  ▎修改后如何生效
#   - 方式一：sudo systemctl restart tg-agent.service
#   - 方式二：面板里选「配置热重载」（sudo tg-agent → 3），无需重启
#
#  ▎安全提醒
#   - 本文件包含机器人令牌和 API 密钥，务必保持权限 600（安装脚本已设置）
#   - 本文件不会进入 Git 仓库，也不会进入发布包
#
# ============================================================
#  一、Telegram 基础配置（必填）
# ============================================================

# Telegram 机器人令牌（必填）
# 获取方法：在 Telegram 里找 @BotFather → 发送 /newbot → 按提示命名 →
# 完成后 BotFather 会发给你一串形如 123456789:AAxxxxxxxxxxxxxxxx 的令牌。
BOT_TOKEN=

# 管理员 Telegram 数字 ID（必填，多个用逗号或空格分隔）
# 获取方法：在 Telegram 里找 @userinfobot，发任意消息，它会回复你的数字 ID。
# 只有这些 ID 能操作机器人，其他人发消息只会收到"无权限"。
ADMIN_IDS=

# 主动推送通知的会话 ID（选填，建议填你自己的 ID）
# 系统告警、备份结果、控制操作反馈都会发到这里。
ADMIN_CHAT_ID=

# Telegram 网络代理（选填，留空=直连）
# 如果你的服务器访问 Telegram 需要走代理，填形如 http://127.0.0.1:7890。
TG_PROXY=

# WOL 远程开机目标电脑的 MAC 地址（选填）
# 格式：AA:BB:CC:DD:EE:FF；填了之后 /wake 命令可直接唤醒这台机器。
WOL_MAC=

# ============================================================
#  二、大模型配置（/ai 自然语言对话必需，斜杠命令不需要）
# ============================================================

# API 服务地址（Base URL）
# - DeepSeek 官方：https://api.deepseek.com
# - OpenAI 官方：  https://api.openai.com/v1
# - 其他兼容服务：填你的服务商地址，如 http://127.0.0.1:8000/v1
LLM_BASE_URL=https://api.deepseek.com

# 大模型 API 密钥（必填才能用 AI 对话）
# - DeepSeek：到 platform.deepseek.com 创建 API Key，形如 sk-xxxxxxxx
# - OpenAI：到 platform.openai.com 创建
LLM_API_KEY=

# 模型名称
# - DeepSeek：deepseek-chat（推荐）或 deepseek-reasoner
# - OpenAI：gpt-4o-mini 等
LLM_MODEL=deepseek-chat

# 单次请求超时秒数（网络差可调大）
LLM_TIMEOUT=20

# AI 思考的最大步骤数（每步=一次工具调用或一次思考）
# 复杂问题可调大，但会消耗更多 token 和时间；一般 8-12 够用。
LLM_MAX_STEPS=8

# 生成温度（0-1，越低越保守稳定）
LLM_TEMPERATURE=0.2

# ============================================================
#  三、路径配置（一般不用改）
# ============================================================

# 项目根目录（systemd 部署时已固定为 /opt/tg-agent，一般无需设置）
# TG_AGENT_ROOT=/opt/tg-agent
# DATA_DIR=
# LOG_DIR=
# DATABASE_PATH=
# UPLOAD_DIR=

# ============================================================
#  四、三维降级阈值（低配服务器保护，一般不用改）
# ============================================================
# 系统负载 / 可用内存 / 磁盘 I/O 任一超限时自动降级，避免卡死宿主服务。

# 一级降级触发：负载 >= 2.8 或 可用内存 <= 1.0GB 或 I/O 等待 >= 200ms
DEGRADE1_LOAD=2.8
DEGRADE1_MEM_GB=1.0
DEGRADE1_IO_MS=200
# 二级降级触发：负载 >= 3.6 或 可用内存 <= 0.5GB 或 I/O 等待 >= 500ms
DEGRADE2_LOAD=3.6
DEGRADE2_MEM_GB=0.5
DEGRADE2_IO_MS=500
# 一级恢复阈值（全部满足才恢复）
RECOVER_LOAD=1.8
RECOVER_MEM_GB=1.2
RECOVER_IO_MS=100
# 二级恢复阈值
RECOVER2_LOAD=2.5
RECOVER2_MEM_GB=0.8
RECOVER2_IO_MS=200

# ============================================================
#  五、命令执行安全（建议保持默认）
# ============================================================

# 命令默认超时秒数
EXEC_DEFAULT_TIMEOUT=60
# 命令最大允许超时（防止恶意长任务）
EXEC_MAX_TIMEOUT=600
# 单条命令输出上限（字节），超出截断
EXEC_MAX_OUTPUT_BYTES=100000
# 每分钟最多执行命令次数
EXEC_CALLS_PER_MIN=20
# AI 可直接执行的只读命令白名单（空格分隔）
EXEC_ALLOWLIST=df free ps uptime uname du who last ss netstat docker

# sudo 死白名单（JSON 数组，只允许精确命令，禁止通配符）
# 需要 AI 执行重启/关机等特权操作时，按此格式精确添加绝对路径。
SUDO_WHITELIST=[["/usr/bin/systemctl","restart","tg-agent.service"],["/usr/bin/systemctl","stop","tg-agent.service"],["/usr/sbin/reboot"],["/usr/sbin/shutdown","-h","now"]]

# ============================================================
#  六、Mihomo（Clash）代理节点管理
# ============================================================

# Mihomo 外部控制器地址（/mihomo、/switch 命令需要）
# 查看方法：Mihomo 面板 → 设置 → 外部控制，默认 http://127.0.0.1:9090 或 9999
MIHOMO_API=http://127.0.0.1:9999

# 节点测速地址与过滤条件（一般不用改）
MIHOMO_TEST_URL=https://www.gstatic.com/generate_204
MIHOMO_DELAY_MAX=800
MIHOMO_DELAY_TIMEOUT=3000
MIHOMO_NODE_LIMIT=80

# ============================================================
#  七、备份
# ============================================================

# 备份目录（相对项目根目录或绝对路径）
BACKUP_DIR=data/backup
# 外置备份目录（选填），填写后备份会自动多同步一份到该目录
BACKUP_EXTERNAL_DIR=
# 备份失败重试次数
BACKUP_RETRIES=2

# ============================================================
#  八、监控与告警（一般不用改）
# ============================================================

# 系统指标采样间隔（秒，最小 5）
METRICS_INTERVAL=60
# 同类告警冷却时间（分钟，防止刷屏）
ALERT_COOLDOWN_MIN=30
# 磁盘可用空间低于此值（GB）触发告警
DISK_LOW_WATER_GB=2
# 离线消息队列上限（Telegram 断线时的缓存条数）
OFFLINE_QUEUE_MAX=20
# 看门狗（事件循环卡死自动重启），生产环境建议开启
WATCHDOG_ENABLED=false
WATCHDOG_FAST_S=30
WATCHDOG_REGULAR_S=120

# ============================================================
#  九、受限上传目录配额（选填）
# ============================================================
UPLOAD_QUOTA_MB=100
UPLOAD_FILE_MAX_MB=10

# ============================================================
#  十、其他
# ============================================================

# 手动补充服务端口（/ports 未识别时）：名称=端口，多个用空格分隔
# 示例：PANEL_SERVICES=下载器=8080 网盘=5244
PANEL_SERVICES=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 单条 Telegram 消息最大长度
MESSAGE_LIMIT=3900
