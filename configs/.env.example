# ============================================================
# TG-Agent 配置示例
# 复制为 configs/.env 并填写真实值：cp configs/.env.example configs/.env
# 敏感文件请 chmod 600 保护
# ============================================================

# ---------- Telegram ----------
BOT_TOKEN=
ADMIN_IDS=
ADMIN_CHAT_ID=
TG_PROXY=

# WOL 目标电脑 MAC（/wake 默认使用）
WOL_MAC=

# ---------- LLM（OpenAI 兼容接口，支持本地 vLLM/Ollama/one-api）----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20
LLM_MAX_STEPS=8
LLM_TEMPERATURE=0.2

# ---------- 路径 ----------
# TG_AGENT_ROOT=/opt/tg-agent
# DATA_DIR=
# LOG_DIR=
# DATABASE_PATH=
# UPLOAD_DIR=

# ---------- 三维降级阈值（Load_1min / 可用内存 GB / I/O 等待 ms）----------
DEGRADE1_LOAD=2.8
DEGRADE1_MEM_GB=1.0
DEGRADE1_IO_MS=200
DEGRADE2_LOAD=3.6
DEGRADE2_MEM_GB=0.5
DEGRADE2_IO_MS=500
RECOVER_LOAD=1.8
RECOVER_MEM_GB=1.2
RECOVER_IO_MS=100

# ---------- 命令执行 ----------
EXEC_DEFAULT_TIMEOUT=60
EXEC_MAX_TIMEOUT=600
EXEC_MAX_OUTPUT_BYTES=100000
EXEC_CALLS_PER_MIN=20
# AI 直接执行工具的只读命令白名单（空格分隔）
EXEC_ALLOWLIST=df free ps uptime uname du who last ss netstat docker

# ---------- sudo 死白名单（JSON，精确 argv，禁止通配符）----------
SUDO_WHITELIST=[["/usr/bin/systemctl","restart","tg-agent.service"],["/usr/bin/systemctl","stop","tg-agent.service"],["/usr/sbin/reboot"],["/usr/sbin/shutdown","-h","now"]]

# ---------- Mihomo（兼容旧平台 system.env 的 MIHOMO_API）----------
MIHOMO_API=http://127.0.0.1:9999
MIHOMO_TEST_URL=https://www.gstatic.com/generate_204
MIHOMO_DELAY_MAX=800
MIHOMO_DELAY_TIMEOUT=3000
MIHOMO_NODE_LIMIT=80

# ---------- 备份 ----------
BACKUP_DIR=data/backup
BACKUP_EXTERNAL_DIR=
BACKUP_RETRIES=2

# ---------- 监控 / 告警 ----------
METRICS_INTERVAL=60
ALERT_COOLDOWN_MIN=30
DISK_LOW_WATER_GB=2
OFFLINE_QUEUE_MAX=20
WATCHDOG_ENABLED=false
WATCHDOG_FAST_S=30
WATCHDOG_REGULAR_S=120

# ---------- 上传（受限目录）----------
UPLOAD_QUOTA_MB=100
UPLOAD_FILE_MAX_MB=10

# ---------- 手动补充服务端口（名称=端口，空格分隔）----------
PANEL_SERVICES=

# ---------- 其他 ----------
LOG_LEVEL=INFO
MESSAGE_LIMIT=3900
